{% comment %}
  YU ONE experience, embedded so that this page owns the scroll.
  Paste all of this into the Custom Liquid block that holds the YU ONE iframe,
  replacing the old <iframe>.

  The experience runs in an iframe one screen tall, pinned (position: sticky)
  inside a wrapper as tall as the whole experience. Visitors scroll this page,
  so the header hides and the footer follows as on any other page; the script
  tells the frame how far into the wrapper they are and the frame follows. It
  also tells the frame how much of the header is showing over it, so the
  frame's own buttons move clear of the header.

  The frame reports its own height, so the wrapper always matches it. Share
  links (?rack=… and #build) are passed through to the frame.

  Source and protocol: src/components/experience/embed.ts in yuone-product-page.
{% endcomment %}

<div class="yu-one-track" data-yu-one-track>
  <iframe
    class="yu-one-frame"
    data-yu-one-frame
    data-src="https://yuone-product-page.vercel.app/"
    title="YU ONE"
    allow="fullscreen; clipboard-write; xr-spatial-tracking"
  ></iframe>
</div>

<style>
  .yu-one-track {
    position: relative;
    /* the full width of the page, past the section's side margins */
    grid-column: 1 / -1;
    /* until the frame reports its height */
    height: 100vh;
    height: 100svh;
  }
  .yu-one-frame {
    position: sticky;
    top: 0;
    display: block;
    width: 100%;
    height: 100vh;
    height: 100svh;
    border: 0;
  }
</style>

<script>
  (() => {
    const track = document.querySelector("[data-yu-one-track]");
    const frame = track && track.querySelector("[data-yu-one-frame]");
    if (!frame) return;
    // the theme's header, to keep the frame's buttons clear of it while it shows
    const header = document.querySelector("#header-component, header");

    // a shared link to this page opens the frame on the same build and section
    const src = new URL(frame.dataset.src);
    const here = new URL(window.location.href);
    if (here.searchParams.has("rack")) src.searchParams.set("rack", here.searchParams.get("rack"));
    if (here.hash) src.hash = here.hash;
    const ORIGIN = src.origin;

    const send = (message) => {
      if (frame.contentWindow) frame.contentWindow.postMessage(Object.assign({ source: "yu-one-host" }, message), ORIGIN);
    };

    // px scrolled into the wrapper, within what the frame can scroll,
    // and px of the header lying over the top of the frame
    let sent = "";
    const sync = () => {
      const box = track.getBoundingClientRect();
      const max = Math.max(0, track.offsetHeight - frame.offsetHeight);
      const y = Math.min(Math.max(-box.top, 0), max);
      const top = frame.getBoundingClientRect().top;
      const inset = header ? Math.max(0, Math.round(header.getBoundingClientRect().bottom - top)) : 0;
      const key = y + ":" + inset;
      if (key === sent) return;
      sent = key;
      send({ type: "scroll", y, inset });
    };

    // the header slides in and out after the scroll has stopped: follow it for a moment
    let until = 0;
    let looping = false;
    const loop = () => {
      sync();
      if (performance.now() < until) requestAnimationFrame(loop);
      else looping = false;
    };
    const onScroll = () => {
      sync();
      until = performance.now() + 700;
      if (!looping) {
        looping = true;
        requestAnimationFrame(loop);
      }
    };

    // say hello until the frame answers: it may still be loading its scripts
    let ready = false;
    let tries = 0;
    const hello = () => send({ type: "hello", url: window.location.href });
    const knock = window.setInterval(() => {
      if (ready || ++tries > 50) return window.clearInterval(knock);
      hello();
    }, 300);
    frame.addEventListener("load", hello);

    // what visitors do in the frame, sent with the store's own tags so it joins the same visit:
    // GA4 through the Google channel app's gtag, GTM's dataLayer, and for a few key moments the
    // Meta and TikTok pixels. Held until the store's GA4 tag is up (it loads after the page).
    // Events and parameters: src/components/experience/track.ts in yuone-product-page.
    const GA4 = "G-C30L2ECJ0J";
    const NAME = /^[a-z][a-z0-9_]{0,39}$/;
    const waiting = [];
    let waitingSince = 0;
    const tagReady = () => !!(window.google_tag_manager && window.google_tag_manager[GA4]);
    const deliver = (data) => {
      const params = {};
      const raw = data.params || {};
      Object.keys(raw).forEach((k) => {
        const v = raw[k];
        if (!NAME.test(k)) return;
        if (typeof v === "string") params[k] = v.slice(0, 100);
        else if (typeof v === "number" && isFinite(v)) params[k] = v;
      });
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push(Object.assign({ event: data.event }, params));
      const gtag = typeof window.gtag === "function" ? window.gtag : function () { window.dataLayer.push(arguments); };
      gtag("event", data.event, Object.assign({ send_to: GA4 }, params));
      if (typeof data.ads === "string" && NAME.test(data.ads)) {
        const ad = { product: params.content_type, action: data.ads };
        try { if (typeof window.fbq === "function") window.fbq("trackCustom", "Product3D", ad); } catch (err) {}
        try { if (window.ttq && typeof window.ttq.track === "function") window.ttq.track("Product3D", ad); } catch (err) {}
      }
    };
    const flush = () => {
      // send anyway after 10 s: gtag queues for its tag if it is still on the way
      if (!tagReady() && performance.now() - waitingSince < 10000) return window.setTimeout(flush, 250);
      waiting.splice(0).forEach(deliver);
    };
    const forward = (data) => {
      if (typeof data.event !== "string" || !NAME.test(data.event)) return;
      if (tagReady() && !waiting.length) return deliver(data);
      if (!waiting.length) {
        waitingSince = performance.now();
        window.setTimeout(flush, 250);
      }
      if (waiting.length < 100) waiting.push(data);
    };

    window.addEventListener("message", (e) => {
      if (e.origin !== ORIGIN || e.source !== frame.contentWindow) return;
      const data = e.data;
      if (!data || data.source !== "yu-one") return;

      if (data.type === "ready") {
        ready = true;
        sent = "";
        sync();
      } else if (data.type === "height" && typeof data.height === "number") {
        track.style.height = data.height + "px";
        sync();
      } else if (data.type === "scroll-to" && typeof data.y === "number") {
        // an in-page link in the experience, such as "Build yours"
        window.scrollTo({
          top: track.getBoundingClientRect().top + window.scrollY + data.y,
          behavior: data.smooth ? "smooth" : "auto",
        });
      } else if (data.type === "address" && typeof data.url === "string") {
        // a share link, where the frame could not reach the clipboard
        const url = new URL(data.url, window.location.href);
        if (url.origin === window.location.origin) window.history.replaceState(null, "", url);
      } else if (data.type === "track") {
        forward(data);
      }
    });

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);

    frame.src = src.href;
  })();
</script>
